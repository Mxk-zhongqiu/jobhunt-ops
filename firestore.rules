rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 每个用户的云端状态文档：只允许读写自己的（uid 必须等于登录用户）
    match /states/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 简历板块（素材库 + 版本）云同步：同样只允许本人读写
    match /resumes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
