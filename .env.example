# 仅由本地 AI 代理读取。不要使用 VITE_ 前缀，也不要提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=1500
DEEPSEEK_TIMEOUT_MS=45000
AI_PROXY_PORT=8787

# ── Firebase 云同步（第二阶段）──
# 这是"公网配置"（Firebase 设计上就随前端下发，不是机密），但只有填写后才会启用云同步。
# 从 Firebase 控制台 → 项目设置 → 常规 → 你的应用（Web）里复制。
# 真正机密的 DEEPSEEK_API_KEY 走云函数环境变量：firebase functions:secrets:set DEEPSEEK_API_KEY
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
